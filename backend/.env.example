# ── MedSync backend environment variables ─────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` is committed so teammates know what is required.

# Server port
PORT=5000

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Google Gemini API (AI Chatbot) ─────────────────────────────────────────
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Default model for the AI assistant. gemini-3.7-flash has been frequently
# overloaded ("high demand" 503s / timeouts), so the app defaults to the stable
# gemini-3.6-flash. gemini-2.0-flash / gemini-1.5-flash* are on Google's
# sunset path. Override freely (e.g. gemini-3.5-flash-lite for lower cost).
GEMINI_MODEL=gemini-3.6-flash

# Fallbacks tried automatically when the primary model is unavailable
# (rate-limited, overloaded, or timing out). Comma-separated, in priority order.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Optional: how long to wait on one model attempt before falling back (ms).
GEMINI_REQUEST_TIMEOUT_MS=25000

# Optional: number of conversational turns of history sent to the model.
# Range 1-20, default 8. Lower = less latency + fewer tokens on long chats.
CHAT_HISTORY_TURNS=8
