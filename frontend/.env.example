# Public backend URLs used by the frontend (set both to the deployed backend).
VITE_BACKEND_URL=https://your-backend.example.com
VITE_API_BASE_URL=https://your-backend.example.com/api

# Supabase project URL and publishable/anon key. These are included in the
# browser build; never put a Supabase service-role/secret key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
