import { useState, useEffect } from 'react';
import { ChevronLeft, ChevronRight, Plus, Video, Clock, Users, AlertTriangle } from 'lucide-react';
import { supabase } from '../../../supabaseClient';

const STATUS_STYLE = {
  ARRIVED: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200/50',
  WAITING: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200/50',
  SCHEDULED: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 border border-slate-200/50',
  PENDING: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200/50',
  CONFIRMED: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200/50',
  COMPLETED: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 border border-slate-200/50',
  CANCELLED: 'bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-300 border border-rose-200/50',
};
const TAG_STYLE = {
  slate: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
  rose: 'bg-rose-50 text-rose-600 dark:bg-rose-950/30 dark:text-rose-400 font-medium px-2 py-0.5 rounded-md text-xs',
};

// Static fallback data (kept for fields not in the database)
const CLINIC_STATUS = { waitTime: '12 min', seen: 4, total: 12, critical: 0 };
const DAILY_VOLUME = [30, 55, 40, 90, 45, 60, 35];
const DAY_LABELS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const TODAY_REVENUE = { amount: '$1,240', consultations: 12 };

const formatTime = (timeStr) => {
  if (!timeStr) return '—';
  const [hours, minutes] = timeStr.split(':').map(Number);
  if (Number.isNaN(hours) || Number.isNaN(minutes)) return timeStr;
  const period = hours >= 12 ? 'PM' : 'AM';
  const hour12 = hours % 12 === 0 ? 12 : hours % 12;
  return `${hour12}:${String(minutes).padStart(2, '0')}`;
};

export default function DoctorDashboard() {
  const today = new Date();
  const dateLabel = today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

  const [doctor, setDoctor] = useState(null);
  const [appointments, setAppointments] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    const loadDashboard = async () => {
      try {
        const { data: sessionData } = await supabase.auth.getSession();
        const user = sessionData?.session?.user;
        if (!user) {
          setError('You must be logged in to view the dashboard.');
          return;
        }

        // Fetch doctor profile by user_id
        const backendUrl = import.meta.env.VITE_API_BASE_URL || 'http://localhost:5000/api';
        const profileResponse = await fetch(`${backendUrl}/doctor/profile/${user.id}`);
        if (!profileResponse.ok) {
          const errData = await profileResponse.json().catch(() => ({}));
          throw new Error(errData.message || `Failed to load doctor profile (${profileResponse.status})`);
        }
        const profileData = await profileResponse.json();
        setDoctor(profileData.doctor);

        // Fetch today's appointments for this doctor
        const todayStr = new Date().toISOString().split('T')[0];
        const apptResponse = await fetch(`${backendUrl}/doctor/appointments/${profileData.doctor.id}`);
        if (!apptResponse.ok) {
          const errData = await apptResponse.json().catch(() => ({}));
          throw new Error(errData.message || `Failed to load appointments (${apptResponse.status})`);
        }
        const apptData = await apptResponse.json();
        const allAppts = apptData.appointments || [];

        // Filter to today's appointments
        const todaysAppts = allAppts.filter((a) => a.appointmentDate === todayStr);
        setAppointments(todaysAppts);
      } catch (err) {
        setError(`Failed to load dashboard: ${err.message}`);
      } finally {
        setLoading(false);
      }
    };

    loadDashboard();
  }, []);

  const renderActionButton = (status) => {
    if (status === 'ARRIVED' || status === 'CONFIRMED') {
      return (
        <button className="bg-[#00b8e6] hover:bg-[#0099c2] text-white px-5 py-2.5 rounded-xl font-medium text-sm transition-colors shadow-sm flex items-center gap-2">
          Start Consultation
        </button>
      );
    }
    if (status === 'WAITING' || status === 'PENDING') {
      return (
        <button className="border border-amber-500 text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/30 px-4 py-2 rounded-xl font-medium text-sm transition-colors">
          Call In Patient
        </button>
      );
    }
    return (
      <button className="text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 px-4 py-2 rounded-xl text-sm font-medium transition-colors">
        View Details
      </button>
    );
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[60vh]">
        <div className="flex flex-col items-center gap-4">
          <svg className="h-10 w-10 animate-spin text-[#00a8cc]" viewBox="0 0 24 24" fill="none">
            <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" />
            <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
          </svg>
          <p className="text-sm font-medium text-slate-500">Loading dashboard...</p>
        </div>
      </div>
    );
  }

  return (
    <div>
      <div className="mb-6 flex items-center justify-between">
        <div>
          <h1 className="text-lg font-semibold text-slate-900 dark:text-slate-100">Today's Schedule</h1>
          <p className="text-sm text-slate-500 dark:text-slate-400 mt-1">
            {dateLabel} • {appointments.length} Appointments
            {doctor && <span className="ml-2 text-cyan-600 dark:text-cyan-400">• {doctor.fullName}</span>}
          </p>
        </div>
        <div className="flex items-center gap-3">
          <div className="flex items-center rounded-lg border border-slate-200 dark:border-slate-700">
            <button aria-label="Previous day" className="p-2 text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-l-lg">
              <ChevronLeft className="w-4 h-4" />
            </button>
            <button className="px-3 py-2 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800">
              Today
            </button>
            <button aria-label="Next day" className="p-2 text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-r-lg">
              <ChevronRight className="w-4 h-4" />
            </button>
          </div>
          <button className="px-4 py-2 rounded-lg bg-[#00b8e6] hover:bg-[#0099c2] text-white text-xs font-semibold transition-colors flex items-center gap-1.5">
            <Plus className="w-3.5 h-3.5" />
            Block Time
          </button>
        </div>
      </div>

      {error && (
        <div className="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700">
          {error}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6">
        <div className="space-y-4">
          {appointments.length === 0 && !error ? (
            <div className="bg-white dark:bg-slate-900 rounded-2xl p-8 border border-slate-100 dark:border-slate-800 text-center">
              <p className="text-slate-500 dark:text-slate-400 text-sm">No appointments scheduled for today.</p>
            </div>
          ) : (
            appointments.map((a, idx) => (
              <div
                key={a.id}
                className={`bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-100 dark:border-slate-800 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col sm:flex-row sm:items-center justify-between ${
                  idx === 0 ? 'border-l-4 border-l-[#00b8e6] shadow-[0_0_20px_rgba(0,184,230,0.08)]' : ''
                }`}
              >
                <div className="flex items-start gap-5 flex-1 min-w-0">
                  <div className="flex-shrink-0">
                    <div className="bg-slate-50 dark:bg-slate-800 rounded-xl px-3 py-2.5 w-20 text-center">
                      <p className="text-lg font-bold text-slate-800 dark:text-slate-100 leading-none">{formatTime(a.startTime)}</p>
                      <p className="text-xs font-normal text-slate-400 dark:text-slate-500 mt-0.5">
                        {a.startTime && a.startTime.split(':')[0] >= '12' ? 'PM' : 'AM'}
                      </p>
                    </div>
                    <p className="mt-1.5 text-[10px] font-medium text-slate-400 dark:text-slate-500 text-center">
                      {a.bookingType === 'BENEFICIARY' ? 'Beneficiary' : 'Self'} • {a.consultationFee > 0 ? `$${a.consultationFee}` : '—'}
                    </p>
                  </div>

                  <div className="min-w-0 flex-1">
                    <div className="flex flex-wrap items-center gap-2 mb-1">
                      <p className="font-semibold text-slate-900 dark:text-white text-base">{a.patientName}</p>
                      <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${STATUS_STYLE[a.status] || STATUS_STYLE.SCHEDULED}`}>{a.status}</span>
                      {a.bookingType === 'BENEFICIARY' ? (
                        <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-300 border border-indigo-200/50">
                          Beneficiary
                        </span>
                      ) : (
                        <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-300 border border-indigo-200/50">
                          In-Person
                        </span>
                      )}
                    </div>
                    <p className="text-sm text-slate-500 dark:text-slate-400 mb-2">
                      {a.patientGender ? `${a.patientGender} • ` : ''}
                      {a.patientDob ? `${new Date().getFullYear() - new Date(a.patientDob).getFullYear()} yrs` : ''}
                      {a.paymentStatus === 'PAID' ? ' • Paid' : a.paymentStatus === 'UNPAID' ? ' • Unpaid' : ''}
                    </p>
                  </div>
                </div>

                <div className="mt-4 sm:mt-0 sm:ml-4 flex-shrink-0">
                  {renderActionButton(a.status)}
                </div>
              </div>
            ))
          )}
        </div>

        <div className="space-y-4">
          <div className="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-5">
            <div className="flex items-center gap-3 mb-3">
              <div className="w-10 h-10 rounded-xl bg-cyan-50 dark:bg-cyan-950/40 flex items-center justify-center">
                <Clock className="w-5 h-5 text-cyan-600 dark:text-cyan-400" />
              </div>
              <div>
                <p className="text-[11px] font-semibold text-slate-400 dark:text-slate-500 tracking-wide">WAIT TIME (AVG)</p>
                <p className="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">{CLINIC_STATUS.waitTime}</p>
              </div>
            </div>
            <div className="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1.5">
              <div className="bg-cyan-500 rounded-full h-1.5" style={{ width: '35%' }} />
            </div>
            <p className="text-[10px] text-slate-400 dark:text-slate-500 mt-2">Average wait time for today's patients</p>
          </div>

          <div className="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-5">
            <div className="flex items-center gap-3 mb-3">
              <div className="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 flex items-center justify-center">
                <Users className="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
              </div>
              <div>
                <p className="text-[11px] font-semibold text-slate-400 dark:text-slate-500 tracking-wide">PATIENTS SEEN</p>
                <p className="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">
                  {appointments.filter((a) => a.status === 'COMPLETED').length} <span className="text-sm font-medium text-slate-400 dark:text-slate-500">/ {appointments.length}</span>
                </p>
              </div>
            </div>
            <div className="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1.5">
              <div className="bg-indigo-500 rounded-full h-1.5" style={{ width: `${appointments.length > 0 ? (appointments.filter((a) => a.status === 'COMPLETED').length / appointments.length) * 100 : 0}%` }} />
            </div>
            <p className="text-[10px] text-slate-400 dark:text-slate-500 mt-2">Patients seen out of total scheduled today</p>
          </div>

          <div className="bg-white dark:bg-slate-900 rounded-2xl border border-rose-200/50 dark:border-rose-950/40 shadow-sm p-5">
            <div className="flex items-center gap-3 mb-3">
              <div className="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/40 flex items-center justify-center">
                <AlertTriangle className="w-5 h-5 text-rose-500 dark:text-rose-400" />
              </div>
              <div>
                <p className="text-[11px] font-semibold text-rose-600 dark:text-rose-400 tracking-wide">CRITICAL ALERTS</p>
                <p className="text-2xl font-bold text-rose-500 dark:text-rose-400 mt-0.5">{CLINIC_STATUS.critical}</p>
              </div>
            </div>
            <p className="text-[10px] text-slate-400 dark:text-slate-500">No critical alerts at the moment</p>
          </div>

          <div className="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-5">
            <div className="flex items-center justify-between mb-4">
              <p className="text-[11px] font-semibold text-slate-400 dark:text-slate-500 tracking-wide">DAILY VOLUME</p>
              <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-50 text-cyan-700 dark:bg-cyan-950/40 dark:text-cyan-300">
                {TODAY_REVENUE.amount} • {TODAY_REVENUE.consultations} consults
              </span>
            </div>
            <div className="flex items-end gap-2 h-24">
              {DAILY_VOLUME.map((v, i) => (
                <div key={i} className="flex-1 flex flex-col items-center gap-1">
                  <div
                    className={`w-full rounded-t ${i === 3 ? 'bg-[#00b8e6]' : 'bg-slate-100 dark:bg-slate-800'}`}
                    style={{ height: `${v}%` }}
                  />
                  <span className={`text-[10px] font-medium ${i === 3 ? 'text-cyan-600 dark:text-cyan-400' : 'text-slate-400 dark:text-slate-500'}`}>
                    {DAY_LABELS[i]}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}